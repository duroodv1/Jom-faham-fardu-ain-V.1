{
  "name": "jom-faham-fardu-ain",
  "version": "1.4.0",
  "description": "JOM FAHAM FARDU AIN V.1 — Belajar, Faham dan Amalkan (PWA luar talian + Windows Electron + Android Capacitor)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "npx --yes serve . -l 8000",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis portable",
    "android:init": "npx cap init \"Jom Faham Fardu Ain\" com.jomfaham.farduain --web-dir=.",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.jomfaham.farduain",
    "productName": "Jom Faham Fardu Ain V1",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "service-worker.js",
      "src/**/*",
      "assets/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jom Faham Fardu Ain V.1"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.3"
  }
}
